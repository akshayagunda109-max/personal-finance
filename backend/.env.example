# Copy to .env and adjust for your environment.

# "development" or "production". Production enables strict startup checks that
# refuse to boot with any of the insecure defaults below still in place.
ENVIRONMENT=development

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finance

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Signing key for auth tokens. Generate a real one for any deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Anyone who knows this value can mint a valid token for any user.
JWT_SECRET=dev-only-insecure-secret-change-in-production
JWT_EXPIRE_MINUTES=10080

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
